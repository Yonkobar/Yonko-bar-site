/*
  Content-Security-Policy: frame-src 'self' https://www.google.com https://maps.googleapis.com https://maps.gstatic.com;

/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/mobile-app.js
  Cache-Control: no-cache
/app-version.json
  Cache-Control: no-store
/api/push/*
  Cache-Control: no-store
/img/*
  Cache-Control: public, max-age=604800
/assets/*
  Cache-Control: public, max-age=86400
/ma-reservation*
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
  Cache-Control: no-store
/api/my-reservation/*
  Cache-Control: no-store
