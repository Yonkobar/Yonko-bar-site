{
  "name": "yonko-bar-push-preview",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {"APP_ORIGIN": "https://test-pwa.yonko-bar-site.pages.dev"},
  "triggers": {"crons": ["*/5 * * * *"]},
  "durable_objects": {"bindings": [{"name": "PUSH_STATE", "class_name": "PushState"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["PushState"]}],
  "kv_namespaces": [{"binding": "RESERVATIONS", "id": "REPLACE_WITH_PREVIEW_KV_NAMESPACE_ID"}],
  "observability": {"enabled": true}
}
