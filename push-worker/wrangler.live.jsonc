{
  "name": "yonko-bar-push-live",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ORIGIN": "https://yonkobar.com"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PUSH_STATE",
        "class_name": "PushState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PushState"
      ]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RESERVATIONS",
      "id": "397918fc08444af4a7706e8891a55b58"
    }
  ],
  "observability": {
    "enabled": true
  }
}
